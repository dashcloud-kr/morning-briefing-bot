# @BotFather 에서 발급한 봇 토큰 (필수)
TELEGRAM_BOT_TOKEN=

# 공공데이터포털 API 키 (필수) — 기상청 단기예보 + 에어코리아 활용신청 후 발급
DATA_GO_KR_KEY=

# 한국수출입은행 환율 API 키 (필수) — https://www.koreaexim.go.kr 에서 신청
KOREAEXIM_API_KEY=

# 오류 알림을 받을 관리자 chat id (선택) — 봇에 /id 를 보내면 확인 가능
ADMIN_CHAT_ID=

# SQLite 저장 경로 (기본: data/bot.db)
DB_PATH=data/bot.db

# 로그 레벨 (기본: INFO)
LOG_LEVEL=INFO
